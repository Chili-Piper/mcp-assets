# === BUILD ARTIFACTS ===
# Packaged skill zips for Claude Desktop / claude.ai upload — built by
# .github/scripts/package_skills.py and attached to GitHub Releases, not committed.
dist/

# === SECRETS & CREDENTIALS ===
.env
.env.*
*.env
# plugins/chili-piper-skills/.mcp.json is intentionally committed — it uses a ${user_config.*}
# reference, not a real secret. Personal override files belong in ~/.claude.json, not here.
**/secrets/
**/.secrets/
**/credentials/
**/.credentials/

# === LOCAL DATA (never commit real data) ===
**/local/
**/.local/

# Root-level data files (use synthetic fixtures in fixtures/ instead)
# Note: mcp.json and .secrets.baseline are excluded from this pattern via negation
/*.csv
/*.parquet
/*.json
!/mcp.json
!/.secrets.baseline
/*.xlsx
/*.xls

# Nested data files — recipes must put real data in their /local/ subfolder
**/data/real/
**/data/live/

# === OS & EDITOR ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# === PYTHON ===
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
.pytest_cache/

# === NODE ===
node_modules/
.npm
.pnpm-store/
dist/
.next/
.nuxt/

# === LOGS ===
*.log
logs/
npm-debug.log*
yarn-debug.log*

# === DEPENDENCY LOCK FILES (keep these) ===
# package-lock.json — keep
# yarn.lock — keep
# uv.lock — keep

# === MCP CONFIG ===
# plugins/chili-piper-skills/.mcp.json uses a ${user_config.*} reference and is intentionally committed.
# claude_desktop_config.json is personal and must never be committed.
claude_desktop_config.json
